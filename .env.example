# Target Artifactory (the /artifactory suffix is added if you give only the host)
ARTIFACTORY_URL=https://artifactory.example.com/artifactory

# Where the mocks live: <repo>/<group path>/<component>/<version>/
MOCKS_REPO=<mocks-repository>
MOCKS_GROUP_PATH=com/example/mocks

# System name (as the dependency graph reports it) = component folder patterns.
# Several systems: separate with ';'. Several patterns: separate with ','.
MOCKS_SYSTEMS=customer-master=cm-*

# Only if anonymous read isn't allowed: an identity or access token
ARTIFACTORY_TOKEN=

# Optional: path to your corporate root CA bundle (PEM) if TLS fails
ARTIFACTORY_CA_BUNDLE=
# ARTIFACTORY_VERIFY_SSL=true

# Optional tuning
# ARTIFACTORY_TIMEOUT=30
# MOCKS_CACHE_TTL=300
# MOCKS_MAX_BODY_CHARS=20000
# MOCKS_MAX_CONCURRENCY=8
